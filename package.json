{
  "name": "cricscore-pro-web",
  "version": "1.0.2",
  "description": "CricLeague PWA - Serverless Cricket Scorer for Intune Managed Browsers",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build-engine.js",
    "build:engine": "node scripts/build-engine.js",
    "start": "npx http-server public -p 8080",
    "test": "npm run build && node --test dist/test/ScoringEngine.test.js",
    "test:e2e": "playwright test",
    "cost:guardrails": "powershell -ExecutionPolicy Bypass -File scripts/aws-cost-guardrails.ps1 -Setup -Report",
    "cost:check": "powershell -ExecutionPolicy Bypass -File scripts/aws-cost-guardrails.ps1 -Report"
  },
  "keywords": [
    "cricket",
    "pwa",
    "aws",
    "serverless",
    "dynamodb"
  ],
  "author": "CricLeague Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3"
  }
}
